{
  "name": "dsh-short-drama",
  "version": "1.5.0",
  "description": "DeepSeek Harness 侧边栏短剧工坊：用 Gemini 按可自定义规则生成分镜词，再通过小云雀 / Dreamina CLI 生成视频。",
  "type": "module",
  "license": "MIT",
  "author": "shangeyao",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "short-drama",
    "storyboard",
    "gemini",
    "video-generation",
    "sidebar-panel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shangeyao/dsh-short-drama.git"
  },
  "homepage": "https://github.com/shangeyao/dsh-short-drama#readme",
  "bugs": {
    "url": "https://github.com/shangeyao/dsh-short-drama/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "prepack": "npm run check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
